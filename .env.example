# Copy to .env for LOCAL testing only (GitHub Actions uses Secrets/Variables instead).
# Load with:  set -a && source .env && set +a && python notifier.py

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Upwork reads run on demand in the official host plugin. No bot search interval.
# Delivery receipts only; contains no plugin authentication or marketplace corpus.
BRIDGE_STATE_PATH=official-delivery.sqlite3

# Max notifications per run (safety cap against flooding; best-scored first)
MAX_NOTIFS=25

# Automatically discard deduplication history older than this many days.
SEEN_TTL_DAYS=30

# ------------------------------------------------------------------
# Filtering is controlled by filters.json (edit that file, not env).
# The two vars below are only a FALLBACK used if filters.json is missing.
# ------------------------------------------------------------------
KEYWORDS=swiftui,ios,swift,flutter,mobile app,ai agent,openai,anthropic,claude,supabase
EXCLUDE_KEYWORDS=wordpress,php,data entry,virtual assistant

# ---- On-demand proposals (optional, free): Google Gemini, tap a button per job ----
# Get a free key at https://aistudio.google.com/apikey  (no credit card).
# When set, every job card shows a "📝 Generate Proposal" button; a draft is written
# ONLY when you tap it (no tokens wasted on jobs you skip). The proposal is built from
# proposal_prompt.md (your "brain") + profile.md. Leave empty to hide the button.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Optional dead-man's-switch (healthchecks.io ping URL) ----
HEALTHCHECK_URL=
