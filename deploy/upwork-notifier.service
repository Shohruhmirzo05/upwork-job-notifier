[Unit]
Description=Upwork job notifier and Telegram proposal bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=upwork-notifier
Group=upwork-notifier
WorkingDirectory=/opt/upwork-notifier/current
ExecStart=/opt/upwork-notifier/current/.venv/bin/python deploy/run_notifier.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Keep Salom AI protected even if the notifier or a dependency misbehaves.
MemoryHigh=300M
MemoryMax=384M
TasksMax=64
CPUQuota=50%
Nice=10
OOMScoreAdjust=500

# The notifier needs the network and its dedicated state directory only.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/upwork-notifier

[Install]
WantedBy=multi-user.target
